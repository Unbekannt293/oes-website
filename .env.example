# Kopie als .env anlegen. .env gehoert NICHT ins Git.

# Postfach fuer Anfragen
NUXT_SMTP_HOST=
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_MAIL_TO=ottos.event-service@outlook.de

# Entfernungsberechnung fuer die Fahrtkosten
# (Google Distance Matrix oder openrouteservice.org)
NUXT_ROUTING_API_KEY=

# Buchungsdatenbank (Supabase -> Project Settings -> API Keys)
# Nur der Secret Key, nie mit NUXT_PUBLIC_ davor: er umgeht alle Zugriffsregeln.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SECRET_KEY=

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Online-Zahlung (Stripe). Lokal Test-Schluessel sk_test_..., live nur in Netlify.
# Webhook-Secret (whsec_...) aus dem Stripe-Dashboard oder "stripe listen".
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
# Zahlungsart "Online bezahlen" an der Kasse anzeigen
NUXT_PUBLIC_ONLINE_PAYMENT=false
